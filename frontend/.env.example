# ==================================================
# FRONTEND ENVIRONMENT VARIABLES (VERCEL / BROWSER)
# All browser-visible variables MUST start with VITE_
# DO NOT put server secrets (MONGODB_URI, JWT_SECRET) here!
# ==================================================

# Render Backend API Base URL
VITE_API_URL=https://MY-RENDER-BACKEND-URL/api

# Application Title & Base URL
VITE_APP_NAME=ALPHA
VITE_APP_BASE_URL=https://MY-VERCEL-FRONTEND-URL

# Optional Firebase Web App Configuration (From Firebase Console -> Project Settings)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
