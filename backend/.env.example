# ==================================================
# BACKEND ENVIRONMENT VARIABLES (RENDER SERVER)
# ==================================================

# Server Environment & Port
PORT=5000
NODE_ENV=production

# Database Connection (MongoDB Atlas URI)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/hackathon_alpha?retryWrites=true&w=majority

# CORS Configuration (Vercel Frontend Deployed URL)
FRONTEND_URL=https://MY-VERCEL-FRONTEND-URL
APP_BASE_URL=https://MY-RENDER-BACKEND-URL

# Authentication & Security Secrets
JWT_SECRET=your_production_jwt_secret_key_change_in_render
SESSION_SECRET=your_production_session_secret_key_change_in_render

# Default Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Initial Hackathon Timer Defaults (Minutes)
READING_DURATION_MINUTES=30
SELECTION_DURATION_MINUTES=5

# File Upload Limits
MAX_FILE_SIZE_MB=10

# Optional Firebase Admin SDK Service Account Credentials (if verifying Firebase Tokens on server)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
